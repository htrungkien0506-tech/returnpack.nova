# ============================================================================
# RETURNPACK MANAGEMENT SYSTEM (RMS) - ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

# 1. Supabase Connection (Public Client Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Supabase Server-Only Key (NEVER EXPOSE TO CLIENT / NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 3. Domain & App URL Configuration
NEXT_PUBLIC_APP_URL=https://app.returnpack.id.vn
NEXT_PUBLIC_QR_BASE_URL=https://app.returnpack.id.vn/return

# 4. Operational Configuration Defaults
DEFAULT_BAG_MAX_CYCLES=15
DEFAULT_REWARD_POINTS_PER_RETURN=100

# 5. Third-Party Logistics / E-Commerce Webhooks (Optional - Manual Dispatch in MVP)
# Status: UNCONNECTED_IN_MVP (Configure when official partner credentials are granted)
GHN_API_TOKEN=
SPX_PARTNER_KEY=
SHOPEE_PARTNER_ID=
TIKTOK_SHOP_APP_KEY=
